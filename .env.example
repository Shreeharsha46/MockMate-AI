# MockMate Environment Configuration Template
# Copy this to .env and fill in with your actual values

# Model Provider - use "ollama" for local models or other providers
MODEL_PROVIDER=ollama

# Model name (e.g., llama3.2, mistral, codellama)
MODEL_NAME=llama3.2

# API base URL (for Ollama default is http://localhost:11434)
API_BASE=http://localhost:11434

# For OpenAI-compatible providers
# OPENAI_API_KEY=your-api-key-here

# Checkpoint database path (optional - defaults to workspace/checkpoints.db)
CHECKPOINT_PATH=workspace/checkpoints.db